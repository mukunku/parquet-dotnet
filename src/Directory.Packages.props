<Project>
    <!-- Central package management: every package version used by the projects under src/ lives here.
         Projects reference packages without a Version. https://learn.microsoft.com/nuget/consume-packages/central-package-management -->
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>

    <!-- Parquet (library) -->
    <ItemGroup>
        <PackageVersion Include="CommunityToolkit.HighPerformance" Version="8.4.2" />
        <PackageVersion Include="K4os.Compression.LZ4" Version="1.3.8" />
        <PackageVersion Include="Microsoft.IO.RecyclableMemoryStream" Version="4.0.1" />
        <PackageVersion Include="Snappier" Version="1.3.3" />
        <PackageVersion Include="ZstdSharp.Port" Version="0.9.1" />
    </ItemGroup>

    <!-- Parquet.Data.Analysis -->
    <ItemGroup>
        <PackageVersion Include="Microsoft.Data.Analysis" Version="0.24.0" />
    </ItemGroup>

    <!-- Release builds of the packages -->
    <ItemGroup>
        <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="1.0.0" />
    </ItemGroup>

    <!-- Parquet.Test -->
    <ItemGroup>
        <PackageVersion Include="CsvHelper" Version="34.1.0" />
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
        <PackageVersion Include="System.IO.Pipelines" Version="9.0.10" />
        <PackageVersion Include="System.ValueTuple" Version="4.6.2" />
        <PackageVersion Include="xunit" Version="2.9.3" />
        <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    </ItemGroup>

    <!-- Parquet.PerfRunner -->
    <ItemGroup>
        <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
        <PackageVersion Include="ParquetSharp" Version="25.0.1.2" />
        <PackageVersion Include="SystemIOCompression.Zstandard.Backporting" Version="11.0.4" />
        <!-- benchmarking a published Parquet.Net instead of the local project: dotnet run -p:ParquetVersion=x.y.z -->
        <PackageVersion Include="Parquet.Net" Version="$(ParquetVersion)" Condition="'$(ParquetVersion)' != ''" />
    </ItemGroup>
</Project>
